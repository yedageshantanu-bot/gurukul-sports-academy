# Frontend Environment Variables (Vite)
# NOTE: Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or payment secret keys here!

# Supabase Public API (From your Supabase Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API URL (Production: https://academy-crm-backend.onrender.com, Dev: /api)
VITE_API_BASE_URL=https://academy-crm-backend.onrender.com
